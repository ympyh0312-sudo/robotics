# scripts/build.sh 가 처음 실행될 때 이 파일을 .env 로 복사한다.
# HOST_UID, HOST_GID, RENDER_GID, VIDEO_GID 는 스크립트가 자동으로 정한다.

# 마운트할 ROS 2 워크스페이스 (호스트 경로)
ROS2_WS=${HOME}/ros2_ws

# 호스트의 ROS 2 Lyrical 과 섞이지 않도록 기본값을 0 이 아닌 값으로 둔다.
# 실제 로봇과 통신할 때는 로봇의 ROS_DOMAIN_ID 와 맞춘다.
ROS_DOMAIN_ID=30

# LOCALHOST: 이 PC 안에서만, SUBNET: 같은 네트워크의 로봇과 통신
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Gazebo transport 분리 (호스트에서 실행하는 Gazebo 와 섞이지 않게 한다)
GZ_PARTITION=ros2_jazzy

# auto   : NVIDIA 런타임 > /dev/dri > CPU 순서로 자동 선택
# nvidia : nvidia-container-toolkit 사용
# dri    : /dev/dri 전달 (AMD/Intel)
# cpu    : 소프트웨어 렌더링
GPU_MODE=auto

# 이미지 이름과 베이스 이미지
IMAGE_NAME=ros2-jazzy-dev:latest
BASE_IMAGE=osrf/ros:jazzy-desktop
