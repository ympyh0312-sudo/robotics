<?xml version="1.0" ?>
<!--
  simple_room: 지도 simple_room.yaml 에서 자동 생성한 월드. 직접 수정하지 말 것.
  지도(PGM)를 고친 뒤 scripts/pgm_to_world.py 를 다시 실행한다.
  좌표계는 지도의 map 프레임과 같다. (x 앞, y 왼쪽, z 위, 단위 m)
-->
<sdf version="1.9">
  <world name="simple_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0.000 0.000 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>14.0 14.0</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14.0 14.0</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="map_obstacles">
      <static>true</static>
      <link name="b0">
        <pose>0.000 -5.100 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.400 0.200 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.400 0.200 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b1">
        <pose>2.000 -2.500 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.600 2.000 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.600 2.000 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b2">
        <pose>1.000 1.000 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.000 1.000 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.000 1.000 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b3">
        <pose>-2.000 1.625 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.300 0.050 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.300 0.050 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b4">
        <pose>-2.000 1.675 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.500 0.050 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.500 0.050 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b5">
        <pose>-2.000 1.725 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.600 0.050 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.600 0.050 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b6">
        <pose>-2.000 1.800 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.700 0.100 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.700 0.100 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b7">
        <pose>-2.000 2.000 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.800 0.300 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.800 0.300 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b8">
        <pose>-2.000 2.200 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.700 0.100 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.700 0.100 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b9">
        <pose>-2.000 2.275 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.600 0.050 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.600 0.050 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b10">
        <pose>-2.000 2.325 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.500 0.050 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.500 0.050 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b11">
        <pose>-2.000 2.375 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.300 0.050 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.300 0.050 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b12">
        <pose>-5.100 0.000 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.200 10.000 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.200 10.000 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b13">
        <pose>5.100 0.000 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.200 10.000 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.200 10.000 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="b14">
        <pose>0.000 5.100 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.400 0.200 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.400 0.200 1.000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
