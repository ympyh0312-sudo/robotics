<?xml version="1.0" ?>
<!--
  simple_room: 10m x 10m 방 + 장애물 3개.
  좌표계: 원점(0,0)이 방 중앙, x는 앞(빨강), y는 왼쪽(초록), z는 위(파랑). 단위는 m.
  이 좌표계가 나중에 ROS 의 `map` 프레임과 같다.
-->
<sdf version="1.9">
  <world name="simple_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 시스템 플러그인: 시뮬레이터가 해야 할 일. 하나라도 빠지면 그 기능이 동작하지 않는다. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- LiDAR 같은 렌더링 센서에 필요하다. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 바깥 벽: 안쪽 면이 ±5m 가 되도록 두께(0.2m)의 절반만큼 바깥에 둔다. -->
    <model name="walls">
      <static>true</static>
      <link name="north">
        <pose>0 5.1 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.4 0.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="south">
        <pose>0 -5.1 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.4 0.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="east">
        <pose>5.1 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 10.4 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.4 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="west">
        <pose>-5.1 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 10.4 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.4 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 장애물 3개. pose 는 "x y z roll pitch yaw", z 는 높이의 절반. -->
    <model name="obstacles">
      <static>true</static>
      <link name="box_1x1">
        <pose>1.0 1.0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="cylinder_r04">
        <pose>-2.0 2.0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_piece">
        <pose>2.0 -2.5 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 2 1</size></box></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
